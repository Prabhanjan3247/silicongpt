# Copy to backend/.env (never commit the real file).
# Claude API key: only read by the backend, never sent to the browser.
ANTHROPIC_API_KEY=
# Model used by all agents (default: claude-opus-5-5)
SGPT_MODEL=claude-opus-5-5
# Server-side refusal fallbacks (beta). Set false if your account rejects the beta.
SGPT_AI_FALLBACKS=true

# Toolchain: OSS CAD Suite root (bin/, lib/, share/verilator). Auto-detected at ../eda-toolchain/oss-cad-suite
# SGPT_TOOLCHAIN_DIR=C:/CSE_Projects/eda-toolchain/oss-cad-suite
# Modern g++ + make for Verilator simulation. Auto-detected at ../eda-toolchain/w64devkit/bin
# SGPT_CXX_DIR=C:/CSE_Projects/eda-toolchain/w64devkit/bin

# Sandbox: local (restricted subprocess) | docker (one --network none container per tool run)
SGPT_SANDBOX_MODE=local
SGPT_SIM_TIMEOUT_S=20
SGPT_COMPILE_TIMEOUT_S=30
SGPT_VERILATOR_BUILD_TIMEOUT_S=240
SGPT_MEM_LIMIT_MB=1024

# Storage (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://...)
# SGPT_DATABASE_URL=sqlite:///./data/silicongpt.db
